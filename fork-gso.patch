diff --git a/quinn/src/connection.rs b/quinn/src/connection.rs
index ff449dd6..82a3171c 100644
--- a/quinn/src/connection.rs
+++ b/quinn/src/connection.rs
@@ -924,7 +924,9 @@ impl ConnectionRef {
                 io_poller: socket.clone().create_io_poller(),
                 socket,
                 runtime,
-                send_buffer: Vec::new(),
+                // Pre-size to the max GSO batch so poll_transmit never
+                // re-grows it on the hot path.
+                send_buffer: Vec::with_capacity(MAX_TRANSMIT_SEGMENTS * 1280),
                 buffered_transmit: None,
             }),
             shared: Shared::default(),
@@ -1331,11 +1333,18 @@ pub enum SendDatagramError {
 ///
 /// This limits the amount of CPU resources consumed by datagram generation,
 /// and allows other tasks (like receiving ACKs) to run in between.
-const MAX_TRANSMIT_DATAGRAMS: usize = 20;
+// Raised 20 -> 80 to let a single drive_transmit fill larger GSO batches
+// under high datagram load (bulk transfer). Paired with
+// MAX_TRANSMIT_SEGMENTS = 40 below.
+const MAX_TRANSMIT_DATAGRAMS: usize = 80;
 
 /// The maximum amount of datagrams that are sent in a single transmit
 ///
 /// This can be lower than the maximum platform capabilities, to avoid excessive
 /// memory allocations when calling `poll_transmit()`. Benchmarks have shown
 /// that numbers around 10 are a good compromise.
-const MAX_TRANSMIT_SEGMENTS: usize = 10;
+// Raised 10 -> 40. With UDP_SEGMENT (Linux GSO) / USO (Windows) this lifts
+// the per-sendmsg payload from ~12.8 KB to ~51.2 KB at MTU 1280, staying
+// under the kernel UDP_MAX_SEGMENTS=64 ceiling. Total GSO payload per
+// sendmsg must stay < u16::MAX (holds for MTU <= 1638 * 40 segments).
+const MAX_TRANSMIT_SEGMENTS: usize = 40;
