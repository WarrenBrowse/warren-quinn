+    fn a_probe_lost_on_an_otherwise_healthy_path_still_narrows_the_search() {
+        // The other half: when only the probe is lost and ordinary traffic flows,
+        // the size IS the suspect and the binary search must keep working
+        // exactly as upstream. Three retransmits, then a smaller size.
+        let mut mtud = default_mtud();
+        let now = Instant::now();
+        let first = mtud
+            .poll_transmit(now, 1)
+            .expect("the first probe goes out");
+        for pn in 2..=3 {
+            mtud.on_probe_lost(false, now);
+            assert_eq!(
+                mtud.poll_transmit(now, pn),
+                Some(first),
+                "a probe lost on a clean path is retransmitted at the same size"
+            );
+        }
+        mtud.on_probe_lost(false, now);
+        let narrowed = mtud.poll_transmit(now, 4).expect("the search continues");
+        assert!(
+            narrowed < first,
+            "after MAX_PROBE_RETRANSMITS the search must conclude the size is \
+             unsupported and try a smaller one, got {narrowed} against {first}"
+        );
