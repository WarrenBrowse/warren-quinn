+    #[test]
+    fn black_hole_detector_ignores_congestion_loss_on_a_uniform_size_flow() {
+        // A bulk flow fills every packet, so a congested link produces loss
+        // bursts whose smallest packet is exactly the size that is also getting
+        // through. `acked_mtu` then equals the burst's size, and a strictly-less
+        // comparison finds no packet "larger than the burst" to exonerate it, so
+        // every congestion burst reads as suspicious and four of them reset the
+        // MTU to the floor. A same-size packet acked more recently than the
+        // burst is the evidence that the size is not the problem.
+        let mut mtud = default_mtud();
+        let size = 1452;
+        let mut pn = 1;
+        for _ in 0..8 {
+            // What a congested link looks like: some packets through, some lost,
+            // all of them the same size, the acks arriving first as quinn
+            // processes them (on_ack_received acks, then detects losses).
+            mtud.on_acked(SpaceId::Data, pn, size);
+            pn += 1;
+            mtud.on_non_probe_lost(pn, size);
+            pn += 1;
+            mtud.on_non_probe_lost(pn, size);
+            pn += 1;
