+    #[test]
+    fn a_probe_lost_while_the_path_drops_ordinary_packets_does_not_narrow_the_search() {
+        // A lost probe is evidence about the probed SIZE only while the path is
+        // otherwise delivering. On a congested link the probe is dropped by the
+        // queue like everything else, and reading that as "this size does not
+        // fit" walks the upper bound down until the search settles far below the
+        // real PMTU. Measured on a member's line: 1017 of 1018 probes lost and
+        // the MTU parked at 1200 to 1230 on a path whose real PMTU was 1492.
+        let mut mtud = default_mtud();
+        let now = Instant::now();
+        let first = mtud
+            .poll_transmit(now, 1)
+            .expect("the first probe goes out");
+
+        mtud.on_probe_lost(true, now);
+
+        assert_eq!(
+            mtud.current_mtu(),
+            1_200,
+            "an inconclusive probe must leave the MTU exactly where it was"
+        );
+        assert_eq!(
+            mtud.poll_transmit(now, 2),
+            None,
+            "the round must END rather than re-probe, or a permanently lossy \
+             link reproduces the probe storm this fixes"
+        );
+        let retry = mtud
+            .poll_transmit(now + Duration::from_secs(600), 3)
+            .expect("the search comes back after the interval");
+        assert_eq!(
+            retry, first,
+            "the retry must probe the same size: nothing was learned about it"
+        );
+    }
+
